<Window x:Class="TurboAuctionWPF.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turbo Auction | Master Control" Height="850" Width="1200" Background="#0A0A0B">
    <Grid>
        <!-- CRITICAL FIX: Resources moved to the top so they are available to elements below -->
        <Grid.Resources>
            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#636366"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
            <Style x:Key="InputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#0A0A0B"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#2D2D30"/>
                <Setter Property="Height" Value="35"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,0"/>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR: SYSTEM MONITOR -->
        <Border Grid.Column="0" Background="#111114" BorderBrush="#1F1F22" BorderThickness="0,0,1,0">
            <StackPanel Margin="25">
                <TextBlock Text="TURBO MASTER" Foreground="White" FontSize="22" FontWeight="Black"/>
                <TextBlock Text="DISTRIBUTED NODE 01" Foreground="#00F2FF" FontSize="10" FontWeight="Bold" Margin="0,2,0,40"/>

                <!-- Live Node Matrix -->
                <Border CornerRadius="8" Background="#0A0A0B" BorderBrush="#2D2D30" BorderThickness="1" Padding="15">
                    <StackPanel>
                        <TextBlock Text="NETWORK STATUS" Foreground="#636366" FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="UserCountText" Text="NODES CONNECTED: 0" Foreground="#10B981" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="ENCRYPTED TCP TUNNEL ACTIVE" Foreground="#3A3A3C" FontSize="9"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="COMMANDS" Foreground="#636366" FontSize="10" FontWeight="Bold" Margin="0,40,0,10"/>
                <Button Content="RESET GLOBAL CLOCK" Height="40" Background="#1C1C1E" Foreground="White" BorderBrush="#00F2FF" Margin="0,5" Click="ResetTimer_Click"/>
                <Button Content="CLEAR SYSTEM LOGS" Height="40" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Margin="0,5"/>

                <Separator Background="#1F1F22" Margin="0,20"/>

                <Button Content="EMERGENCY SHUTDOWN" Height="45" Background="#1C1C1E" Foreground="#EF4444" BorderBrush="#EF4444" FontWeight="Bold" Click="Shutdown_Click"/>
            </StackPanel>
        </Border>

        <!-- MAIN COMMAND CENTER -->
        <Grid Grid.Column="1" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ASSET DEPLOYMENT CONSOLE" Foreground="White" FontSize="24" FontWeight="Light" Margin="0,0,0,30"/>

            <!-- INPUT GRID -->
            <Border Grid.Row="1" Background="#111114" CornerRadius="12" BorderBrush="#1F1F22" BorderThickness="1" Padding="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- IMAGE STAGING AREA -->
                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="ASSET VISUAL" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Background="#0A0A0B" Height="200" CornerRadius="8" BorderBrush="#2D2D30" BorderThickness="1">
                            <Image x:Name="AdminPreviewImage" Stretch="Uniform" Margin="10"/>
                        </Border>
                        <Button Content="BROWSE LOCAL PC" Height="35" Margin="0,15,0,0" Background="#1C1C1E" Foreground="White" Click="BrowseImage_Click"/>
                    </StackPanel>

                    <!-- DATA MATRIX -->
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column 1 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <TextBlock Text="BRAND" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="BrandIn" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                            <TextBlock Text="START PRICE ($)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="PriceIn" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                            <TextBlock Text="HORSEPOWER" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="HPIn" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="5">
                            <TextBlock Text="FUEL TYPE" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="FuelIn" Style="{StaticResource InputStyle}"/>
                        </StackPanel>

                        <!-- Column 2 -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <TextBlock Text="MODEL" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="ModelIn" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                            <TextBlock Text="ENGINE" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="EngineIn" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                            <TextBlock Text="0-100 KM/H" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="AccelIn" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="5">
                            <TextBlock Text="TRANSMISSION" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TransIn" Style="{StaticResource InputStyle}"/>
                        </StackPanel>

                        <!-- Full Width Description -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="5,15,5,5">
                            <TextBlock Text="ASSET DESCRIPTION" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="DescIn" Height="51" VerticalContentAlignment="Top" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource InputStyle}" Width="473"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Content="STAGE DATA" Width="150" Height="37" Background="#1C1C1E" Foreground="White" Margin="0,0,10,0" Click="DeployAsset_Click"/>
                                <Button Content="BROADCAST LIVE" Width="200" Height="39" Background="#00F2FF" Foreground="#0A0A0B" FontWeight="Bold" Click="StartAuction_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- TERMINAL LOG -->
            <StackPanel Grid.Row="2" Margin="0,30,0,0">
                <TextBlock Text="SYSTEM TRAFFIC LOG" Foreground="#636366" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                <!-- This Name "AdminLog" is what the C# code uses to show your IP and Bids -->
                <ListBox x:Name="AdminLog" Height="150" Background="#050505" Foreground="#10B981" BorderBrush="#1F1F22" FontFamily="Consolas" FontSize="11"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>