<Window x:Class="TurboAuctionWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Turbo Auction Elite Dashboard" Height="750" Width="1200" Background="#F4F6F8">

    <Grid>
        <!-- TabControl allows switching between Login and Dashboard screens -->
        <TabControl x:Name="MainViewSwitcher" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.Resources>

            <!-- SECTION 1: LOGIN SCREEN -->
            <TabItem x:Name="LoginTab">
                <Grid Background="#F4F6F8">
                    <Border Background="#1F2937" Width="400" Height="420" CornerRadius="20" VerticalAlignment="Center">
                        <StackPanel Margin="40">
                            <TextBlock Text="TURBO AUCTION" Foreground="White" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                            <TextBlock Text="USER IDENTITY" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="UsernameBox" Height="35" Background="#111827" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                            <TextBlock Text="ADMIN IP ADDRESS" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="IPBox" Text="127.0.0.1" Height="35" Background="#111827" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                            <TextBlock Text="ASSIGNED PORT" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="PortBox" Text="8080" Height="35" Background="#111827" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,25"/>

                            <Button Content="REQUEST ACCESS" Height="50" Background="#3B82F6" Foreground="White" FontWeight="Bold" Click="Login_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SECTION 2: BIDDING DASHBOARD -->
            <TabItem x:Name="AuctionTab">
                <Grid Background="#F4F6F8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <!-- Specs -->
                        <ColumnDefinition Width="*"/>
                        <!-- Main Broadcast -->
                        <ColumnDefinition Width="300"/>
                        <!-- Clock & Feed -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDEBAR: TECHNICAL SPECS -->
                    <Border Grid.Column="0" Background="#1F2937" Padding="25">
                        <StackPanel>
                            <TextBlock Text="OPERATOR IDENTITY" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="ActiveUserLabel" Text="Guest" Foreground="#00F2FF" FontSize="16" FontWeight="Bold" Margin="0,0,0,25"/>
                            <TextBlock Text="TECHNICAL SPECS" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>
                            <StackPanel Margin="0,0,0,30">
                                <TextBlock x:Name="SpecBrand" Text="Brand: --" Foreground="White" Margin="0,8" FontSize="14"/>
                                <TextBlock x:Name="SpecModel" Text="Model: --" Foreground="White" Margin="0,8" FontSize="14"/>
                                <TextBlock x:Name="SpecEngine" Text="Engine: --" Foreground="White" Margin="0,8" FontSize="14"/>
                                <TextBlock x:Name="SpecHP" Text="Horsepower: --" Foreground="White" Margin="0,8" FontSize="14"/>
                                <TextBlock x:Name="SpecTopSpeed" Text="Top Speed: --" Foreground="White" Margin="0,8" FontSize="14"/>
                                <TextBlock x:Name="SpecAccel" Text="0-100 km/h: --" Foreground="White" Margin="0,8" FontSize="14"/>
                                <TextBlock x:Name="SpecTrans" Text="Transmission: --" Foreground="White" Margin="0,8" FontSize="14"/>
                                <TextBlock x:Name="SpecFuel" Text="Fuel: --" Foreground="White" Margin="0,8" FontSize="14"/>
                            </StackPanel>

                            <TextBlock Text="DESCRIPTION" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="SpecDesc" Text="Awaiting asset deployment..." Foreground="White" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- CENTER: MAIN LIVE BROADCAST -->
                    <Border Grid.Column="1" Background="White" Margin="18" Padding="30" CornerRadius="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Title -->
                                <RowDefinition Height="*"/>
                                <!-- Image & Price -->
                                <RowDefinition Height="Auto"/>
                                <!-- Bidding Controls -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="LIVE ASSET BROADCAST" Foreground="#1F2937" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <Border Grid.Row="1" Background="#F9FAFB" CornerRadius="15" BorderBrush="#E5E7EB" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" x:Name="CarDisplay" Stretch="Uniform" Margin="15"/>
                                    <TextBlock Grid.Row="1" x:Name="PriceText" Text="$0,000,000" Foreground="#059669" FontSize="38" FontWeight="Black" VerticalAlignment="Center" TextAlignment="Center"  HorizontalAlignment="Center"  Margin="0,0,0,20"/>
                                </Grid>
                            </Border>

                            <!-- BIDDING PANEL: Positioned Under the Image -->
                            <StackPanel x:Name="BiddingPanel" Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,25,0,0">
                                <TextBlock Text="SET YOUR BID AMOUNT" Foreground="#64748B" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Width="45" Height="45" Background="#1F2937" Foreground="White" FontSize="20" Click="DecreaseBid_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8,0,0,8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <TextBox x:Name="BidAmountBox" Text="5000" Width="120" Height="45" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="18" FontWeight="Bold" BorderBrush="#E2E8F0"/>

                                    <Button Content="+" Width="45" Height="45" Background="#1F2937" Foreground="White" FontSize="20" Click="IncreaseBid_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="0,8,8,0"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button x:Name="PlaceBidBtn" Content="PLACE BID" Width="180" Height="45" Background="#059669" Foreground="White" FontWeight="Bold" Margin="15,0,0,0" Click="Bid_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RIGHT SIDEBAR: AUCTION CLOCK & FEED -->
                    <Border Grid.Column="2" Background="#111827" Padding="25">
                        <StackPanel>
                            <TextBlock Text="AUCTION CLOCK" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ProgressBar x:Name="TimerBar" Height="12" Maximum="30" Value="30" Foreground="#10B981" Background="#1F2937" BorderThickness="0" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TimerText" Text="Time Left: 00:30" Foreground="White" HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,40"/>

                            <TextBlock Text="SYSTEM FEED" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox x:Name="NotificationList" Height="350" Background="Transparent" BorderThickness="0" Foreground="#D1D5DB" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>